{
  "name": "unified TREE",
  "short_name": "TREE",
  "description": "Web control plane for the growing SoC device-node fleet",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "any",
