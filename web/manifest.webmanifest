    {"src": "./icons/tree-maskable.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "maskable"}
  ],
  "shortcuts": [
    {"name": "Node fleet", "short_name": "Nodes", "url": "./#fleet", "icons": [{"src": "./icons/tree.svg", "sizes": "any", "type": "image/svg+xml"}]}
  ]
}
